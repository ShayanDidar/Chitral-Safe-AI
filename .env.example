# ─────────────────────────────────────────────────────────────
# Chitral Safe — environment variables
# Copy to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Everything is optional: without any of these the app runs in demo mode.
# ─────────────────────────────────────────────────────────────

# ── AI assistant (server-side only — never exposed to the browser) ──
# Leave empty to use built-in demo responses.
AI_API_KEY=

# "anthropic" or "openai" (= any OpenAI-compatible API: OpenAI, Groq,
# OpenRouter, Together, Google Gemini's OpenAI endpoint, ...).
# Optional — auto-detected from the key ("sk-ant-..." → Anthropic,
# "AIza..." / "AQ...." → Google Gemini, anything else → OpenAI).
AI_PROVIDER=

# Model name. Defaults: Anthropic → claude-sonnet-5, Gemini → gemini-3.6-flash
# (with automatic fallback to other Gemini models when busy),
# OpenAI → gpt-4o-mini.
# Set this for any non-OpenAI OpenAI-compatible provider.
AI_MODEL=

# Base URL for OpenAI-compatible providers. Examples:
#   https://api.openai.com/v1                                 (default)
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=

# ── Weather ──
# "demo" (default) or "open-meteo" (live data, free, no API key needed).
WEATHER_PROVIDER=demo

# ── Map (optional) ──
# The map works out of the box with free, keyless Esri / OpenTopoMap tiles.
# Override only if you want a different tile provider.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
